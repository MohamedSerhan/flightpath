{
  "name": "flightpath",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "bun --hot src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "build:static": "VITE_STATIC_DATA=1 vite build && bun src/scrapers/export.ts && bun src/scrapers/export-rss.ts",
    "export": "bun src/scrapers/export.ts && bun src/scrapers/export-rss.ts",
    "scrape": "bun src/scrapers/run.ts",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun src/scrapers/run.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "drizzle-orm": "^0.36.4",
    "fast-xml-parser": "^4.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@tanstack/react-query": "^5.62.7",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.3",
    "typescript": "^5.7.2",
    "tailwindcss": "^3.4.17",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "drizzle-kit": "^0.28.1",
    "concurrently": "^9.1.0"
  }
}
